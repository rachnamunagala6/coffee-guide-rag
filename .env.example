# Copy to .env and fill in.
ANTHROPIC_API_KEY=your-key-here

# Elasticsearch (defaults to the local Docker container)
ES_URL=http://localhost:9200
# ES_API_KEY=            # set this for Elastic Cloud / secured clusters
ES_INDEX=coffee-guide

# Models
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=claude-sonnet-5-5

# Chunking / retrieval
CHUNK_WORDS=250
CHUNK_OVERLAP=50
TOP_K=5
